# Maintainer: MaurerAnton <open-code@maurer.pw>
pkgname=opencode-bin
pkgver=1.15.6
pkgrel=1
pkgdesc="AI-powered development tool (fork — tabs, Node.js, permissions, browser)"
arch=('x86_64' 'aarch64')
url="https://github.com/MaurerAnton/opencode"
license=('MIT')
depends=('glibc')
provides=('opencode')
conflicts=('opencode')

_arch_name() {
  case "${CARCH}" in
    x86_64) echo "x86_64" ;;
    aarch64) echo "aarch64" ;;
  esac
}

source=("https://github.com/MaurerAnton/opencode/releases/download/v${pkgver}-fork/opencode-${pkgver}-1-$(_arch_name).pkg.tar.zst")
sha256sums=('SKIP')

package() {
  install -Dm755 "${srcdir}/usr/bin/opencode" "${pkgdir}/usr/bin/opencode"
  install -Dm644 "${srcdir}/usr/share/licenses/opencode/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
